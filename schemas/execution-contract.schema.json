{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-integrity:execution-contract:1.0",
  "title": "Trace Integrity Execution Contract",
  "type": "object",
  "required": ["schema_version", "request_id", "intent", "schema_commitments", "plan"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "schema_commitments": {
      "type": "object",
      "properties": {
        "tables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "joins": {"type": "array", "items": {"type": "string"}},
        "filters": {"type": "array", "items": {"type": "string"}},
        "group_by": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "items": {"type": "string"}},
        "ordering": {"type": "array", "items": {"type": "string"}},
        "limits": {"type": "array", "items": {"type": "string"}},
        "temporal_constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "operation"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "operation": {"type": "string", "minLength": 1},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "value_access": {
      "type": "object",
      "properties": {
        "used_before_plan": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "plan_change": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "artifact_type": {"type": "string"},
        "artifact": {"type": "string"},
        "status": {"type": "string", "enum": ["not_run", "succeeded", "failed"]},
        "data_snapshot": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "result_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "final_answer": {
      "type": "object",
      "properties": {
        "text": {"type": ["string", "null"]},
        "result_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "trace_integrity": {
      "type": "object",
      "properties": {
        "explicit": {"$ref": "#/$defs/assessment"},
        "executable": {"$ref": "#/$defs/assessment"},
        "schema_valid": {"$ref": "#/$defs/assessment"},
        "operator_faithful": {"$ref": "#/$defs/assessment"},
        "replayable": {"$ref": "#/$defs/assessment"},
        "answer_consistent": {"$ref": "#/$defs/assessment"},
        "auditable": {"$ref": "#/$defs/assessment"},
        "overall_status": {"type": "string", "enum": ["not_assessed", "pass", "fail", "indeterminate"]}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["not_assessed", "pass", "fail", "indeterminate"]},
        "basis": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
